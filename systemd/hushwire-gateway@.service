[Unit]
Description=HushWire LAN forwarding gateway (%i)
Requires=hushwire@%i.service
After=hushwire@%i.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=30
StartLimitBurst=10

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/hushwire gateway apply -c /etc/hushwire/%i.toml
ExecStop=/usr/local/bin/hushwire gateway remove -c /etc/hushwire/%i.toml
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
